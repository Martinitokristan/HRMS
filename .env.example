APP_NAME=HRMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

# Bypass PHP version requirement (for PHP 7.4 compatibility)
COMPOSER_PLATFORM_CHECK=disable

LOG_CHANNEL=stack
LOG_LEVEL=debug

# LOCAL DATABASE CONFIGURATION (XAMPP/MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms
DB_USERNAME=root
DB_PASSWORD=

# LOCAL: file | PRODUCTION (Railway Redis): redis
CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=database

# Redis (Railway injects REDIS_URL automatically when Redis service is added)
REDIS_CLIENT=predis
REDIS_URL=
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_email@domain.com
MAIL_PASSWORD=your_brevo_smtp_key_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_brevo_verified_email@domain.com
MAIL_FROM_NAME="Hardware Retail Management System"

# Brevo API Settings
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_brevo_verified_email@domain.com
BREVO_FROM_NAME="Hardware Retail Management System"

# Broadcasting (Laravel)
BROADCAST_DRIVER=pusher

# Pusher / Soketi WebSocket
# --- Option A: Pusher Cloud (recommended, free tier at pusher.com) ---
# Leave PUSHER_HOST empty to use Pusher's cloud servers automatically
PUSHER_APP_ID=your_pusher_app_id
PUSHER_APP_KEY=your_pusher_key
PUSHER_APP_SECRET=your_pusher_secret
PUSHER_APP_CLUSTER=ap1
PUSHER_HOST=
PUSHER_PORT=443
PUSHER_SCHEME=https

# --- Option B: Self-hosted Soketi (requires Node 14/16/18) ---
# PUSHER_APP_ID=hrms-app
# PUSHER_APP_KEY=hrms-key
# PUSHER_APP_SECRET=hrms-secret
# PUSHER_APP_CLUSTER=mt1
# PUSHER_HOST=127.0.0.1
# PUSHER_PORT=6001
# PUSHER_SCHEME=http

# Frontend (laravel-mix/webpack) - MIX_ prefix exposes vars as process.env.MIX_* in JS
# Must mirror the Pusher vars above
MIX_PUSHER_APP_KEY=your_pusher_key
MIX_PUSHER_APP_CLUSTER=ap1
MIX_PUSHER_HOST=
MIX_PUSHER_PORT=443
MIX_PUSHER_SCHEME=https

# Remove.bg API (Background Removal for Carousel Banners)
REMOVEBG_API_KEY=your_removebg_api_key_here

# Gemini API (AI-Generated Banner Backgrounds)
GEMINI_API_KEY=your_gemini_api_key_here

# iProg SMS API (https://sms.iprogtech.com)
IPROGSMS_API_TOKEN=your_iprogsms_api_token_here
