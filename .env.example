APP_NAME=HRMS
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

LOG_CHANNEL=stack
LOG_LEVEL=debug

# LOCAL DATABASE CONFIGURATION (XAMPP/MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=hrms
DB_USERNAME=root
DB_PASSWORD=

CACHE_DRIVER=file
SESSION_DRIVER=file
QUEUE_CONNECTION=sync

FILESYSTEM_DISK=local

MAIL_MAILER=smtp
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USERNAME=your_brevo_email@domain.com
MAIL_PASSWORD=your_brevo_smtp_key_here
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=your_brevo_verified_email@domain.com
MAIL_FROM_NAME="Hardware Retail Management System"

# Brevo API Settings
BREVO_API_KEY=your_brevo_api_key_here
BREVO_FROM_EMAIL=your_brevo_verified_email@domain.com
BREVO_FROM_NAME="Hardware Retail Management System"
